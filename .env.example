# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Zapier MCP server URL (Phase 5). Leave empty to use SIMULATED_MODE.
ZAPIER_MCP_URL=
# true = write actions to outputs/mcp_log.json instead of calling Zapier
SIMULATED_MODE=true
# Live mode only: the Google Doc to append to (name as Zapier lists it), and an optional draft recipient
GOOGLE_DOC_ID=
DRAFT_TO=
